<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>提示資料集 - 酸素トラック</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@500;700;900&family=Zen+Old+Mincho:wght@600&display=swap" rel="stylesheet">
<style>
  :root {
    --ink: #16211b; --ink-soft: #5b655e; --paper: #f1f4f1; --line: #d8ded8;
    --green: #17805e; --green-deep: #0b4a35; --green-tint: #dff0e7;
    --rust: #b65b34; --rust-deep: #7c3d20; --rust-tint: #f6e4d9;
    --color-co2-40: #10b981; --color-co2-60: #f97316; --truck-empty: #e2e8f0;
  }
  * { box-sizing: border-box; }
  html, body { margin:0; height:100%; background: var(--paper); color: var(--ink); font-family: "Zen Kaku Gothic New","Hiragino Sans","Yu Gothic",sans-serif; }
  .view { position:absolute; inset:0; display:none; overflow:auto; }
  .view.active { display:flex; }

  #menu.active { flex-direction:column; align-items:center; justify-content:center; padding:6vh 6vw; }
  #menu h1 { font-size: clamp(19px,2vw,24px); font-weight:700; color: var(--ink-soft); margin:0 0 4.5vh; letter-spacing:.06em; }
  .grid { display:grid; grid-template-columns: repeat(3, minmax(210px, 1fr)); gap: 1.8vw; width: 100%; max-width: 1080px; }
  .card {
    background:#fff; border:1px solid var(--line); border-radius:16px;
    padding: 3.2vh 1.4vw; cursor:pointer; text-align:left;
    display:flex; align-items:center; gap: 1.1vw;
    transition: border-color .15s ease, transform .15s ease, box-shadow .15s ease;
  }
  .card:hover { border-color: var(--green); transform: translateY(-2px); box-shadow: 0 10px 22px -14px rgba(11,74,53,.35); }
  .badge { width:44px; height:44px; border-radius:12px; background: var(--green-tint); color: var(--green-deep); display:flex; align-items:center; justify-content:center; flex-shrink:0; }
  .badge svg { width:24px; height:24px; }
  .card .num { font-size: 11px; font-weight:700; color: var(--green); letter-spacing:.14em; display:block; margin-bottom:2px; }
  .card .ttl { font-size: clamp(15px,1.4vw,18px); font-weight:700; line-height:1.4; }

  .diagram { flex-direction:column; align-items:center; justify-content:center; padding: 4vh 5vw; position:relative; }
  .back { position:absolute; top:4vh; left:5vw; font-size: 14px; font-weight:700; color: var(--ink-soft); cursor:pointer; padding:0; background:none; border:none; display:flex; align-items:center; gap:6px; z-index:20; }
  .back:hover { color: var(--green-deep); }
  .dtitle { font-size: clamp(13px,1.4vw,16px); font-weight:700; color: var(--ink-soft); letter-spacing:.12em; margin-bottom: 3.4vh; text-transform:uppercase; }

  .flowbox { display:flex; align-items:center; gap: 2.6vw; }
  .organ { background: var(--green-tint); border-radius:20px; padding: 4.5vh 3.4vw; text-align:center; min-width:230px; }
  .organ.tissue { background: var(--rust-tint); }
  .organ .l1 { font-family:"Zen Kaku Gothic New"; font-size: clamp(15px,1.6vw,18px); font-weight:700; color: var(--green-deep); margin-bottom:1.4vh; letter-spacing:.06em; }
  .organ.tissue .l1 { color: var(--rust-deep); }
  .organ .l2 { font-family: "Zen Old Mincho", serif; font-size: clamp(56px,7vw,104px); font-weight:600; line-height:1; color: var(--green-deep); }
  .organ.tissue .l2 { color: var(--rust-deep); }
  .organ .l3 { font-size: clamp(12px,1.2vw,14px); color: var(--ink-soft); margin-top:1.2vh; letter-spacing:.04em; }
  .roadwrap { display:flex; flex-direction:column; align-items:center; gap:1.4vh; color: var(--ink-soft); }
  .roadwrap svg { width:40px; height:40px; color: var(--green-deep); }
  .roadwrap .arrowline { width:60px; height:2px; background: var(--line); position:relative; }
  .roadwrap .arrowline::after { content:""; position:absolute; right:-1px; top:-3px; border:4px solid transparent; border-left-color: var(--ink-soft); }

  svg.graph { width: min(52vw, 580px); height:auto; }
  .curve-a { stroke: var(--green); } .curve-b { stroke: var(--rust); }
  .toggle-btn { margin-top:2.2vh; font-family:"Zen Kaku Gothic New"; font-size:14px; font-weight:700; padding:10px 24px; border-radius:999px; border:1.5px solid var(--ink); background:#fff; color:var(--ink); cursor:pointer; transition: all .15s ease; }
  .toggle-btn:hover { background: var(--ink); color:#fff; }
  .readout { font-size:14px; color: var(--ink-soft); margin-top:1.6vh; min-height:20px; font-weight:500; }
  .readout b { color: var(--ink); }

  /* 図3：トラックアニメーション */
  #v3 .card3 { background:#fff; border-radius:16px; padding:24px 28px; border:1px solid var(--line); max-width: 480px; width:100%; }
  #v3 button.playbtn3 {
    background:#fff; border:1px solid var(--line); color:var(--ink); cursor:pointer;
    transition: all .2s ease; border-radius:8px; padding:8px 20px; font-size:13px; font-weight:600;
  }
  #v3 button.playbtn3:hover:not(:disabled) { background:#f3f4f6; border-color:#d1d5db; }
  #v3 button.playbtn3:active:not(:disabled) { transform:scale(.96); }
  #v3 button.playbtn3:disabled { opacity:.5; cursor:default; }
  @keyframes truckBounce3 { 0%,100%{transform:translateY(0);} 50%{transform:translateY(-3px);} }
  .moving3 { animation: truckBounce3 .25s ease-in-out infinite; }
  @keyframes loadBubble3 { 0%{opacity:0; transform:translate(-10px,-24px) scale(.4);} 50%{opacity:.9;} 100%{opacity:0; transform:translate(12px,2px) scale(.9);} }
  @keyframes unloadBubble3 { 0%{opacity:.9; transform:translate(12px,2px) scale(.9);} 50%{opacity:.8;} 100%{opacity:0; transform:translate(28px,22px) scale(.4);} }
  .particle-bubble3 { position:absolute; width:14px; height:14px; border-radius:50%; color:#fff; font-size:8px; font-weight:bold; display:flex; align-items:center; justify-content:center; pointer-events:none; z-index:10; }
  .particle-load3 { background: var(--color-co2-40); animation: loadBubble3 .8s cubic-bezier(.25,.46,.45,.94) infinite; }
  .particle-unload3 { background: var(--color-co2-60); animation: unloadBubble3 .8s cubic-bezier(.25,.46,.45,.94) infinite; }

  /* 図4 問いのみ */
  .qmark { font-family:"Zen Old Mincho",serif; font-size: clamp(90px,12vw,170px); color: var(--rust); line-height:1; margin-bottom: 2vh; }
  .qtext { font-size: clamp(24px,2.8vw,36px); font-weight:700; text-align:center; max-width: 26ch; line-height:1.7; }

  /* 図5：胎児・高地 */
  .qpair5 { display:flex; gap: 2.6vw; }
  .qbox5 { background:#fff; border-radius:20px; padding: 2.6vh 1.8vw; text-align:center; box-shadow: 0 10px 26px -14px rgba(20,33,28,.2); width: 380px; }
  .qbox5 .ic { font-size: 32px; margin-bottom: .8vh; }
  .qbox5 .qb { font-size: clamp(15px,1.5vw,18px); font-weight:700; line-height:1.5; margin-bottom: 1.6vh; }
  .minisvg { width: 100%; height:auto; }
  .togglepair { display:flex; gap:8px; justify-content:center; margin-top:1.4vh; }
  .tbtn { font-size:12px; font-weight:700; padding:7px 14px; border-radius:999px; border:1px solid var(--line); background:#fff; cursor:pointer; }
  .tbtn.on1 { border-color:#4f8fd9; color:#2a5c94; background:#e8f1fb; }
  .tbtn.on2 { border-color:var(--rust); color:var(--rust-deep); background:var(--rust-tint); }

  /* 図6：生徒用インタラクティブアプリ */
  #app { display:none; }
  #app.active { display:block; padding: 5vh 4vw 4vh; }
  #app .app-inner { max-width: 980px; margin: 0 auto; }
  #app .header-area { text-align:center; margin-bottom:20px; }
  #app .header-area h2 { font-size:20px; margin:0 0 6px; font-weight:700; }
  #app .header-area p { font-size:13px; color:#6b7280; margin:0; }
  #app .pc-grid { display:grid; grid-template-columns:1fr; gap:20px; align-items:start; }
  @media (min-width: 768px) { #app .pc-grid { grid-template-columns: 1fr 1fr; } }
  #app .acard { background:#fff; border-radius:16px; padding:20px; border:1px solid #e5e7eb; box-shadow: 0 4px 6px -1px rgba(0,0,0,.05); }
  #app button.abtn { background:#fff; border:1px solid #e5e7eb; color:#1f2937; cursor:pointer; transition:all .2s ease; border-radius:8px; padding:6px 16px; font-size:13px; font-weight:600; }
  #app button.abtn:hover:not(:disabled) { background:#f3f4f6; border-color:#d1d5db; }
  #app button.abtn:active:not(:disabled) { transform:scale(.96); }
  #app button.abtn:disabled { opacity:.5; cursor:default; }
  @keyframes truckBounce { 0%,100%{transform:translateY(0);} 50%{transform:translateY(-3px);} }
  #app .moving { animation: truckBounce .25s ease-in-out infinite; }
  @keyframes loadBubble { 0%{opacity:0; transform:translate(-10px,-24px) scale(.4);} 50%{opacity:.9;} 100%{opacity:0; transform:translate(12px,2px) scale(.9);} }
  @keyframes unloadBubble { 0%{opacity:.9; transform:translate(12px,2px) scale(.9);} 50%{opacity:.8;} 100%{opacity:0; transform:translate(28px,22px) scale(.4);} }
  #app .particle-bubble { position:absolute; width:14px; height:14px; border-radius:50%; color:#fff; font-size:8px; font-weight:bold; display:flex; align-items:center; justify-content:center; pointer-events:none; z-index:10; }
  #app .particle-load { background: var(--color-co2-40); animation: loadBubble .8s cubic-bezier(.25,.46,.45,.94) infinite; }
  #app .particle-unload { background: var(--color-co2-60); animation: unloadBubble .8s cubic-bezier(.25,.46,.45,.94) infinite; }
</style>
</head>
<body>

<div class="view active" id="menu">
  <h1>提示資料　｜　必要な図をクリックして表示</h1>
  <div class="grid">
    <div class="card" data-go="v1">
      <div class="badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3c-2 0-3 2-3 5v6c0 3-2 6-2 6h4a3 3 0 0 0 3-3V6"/><path d="M15 3c2 0 3 2 3 5v6c0 3 2 6 2 6h-4a3 3 0 0 1-3-3V6"/><line x1="12" y1="3" x2="12" y2="9"/></svg></div>
      <div><span class="num">01</span><div class="ttl">肺と組織の酸素濃度</div></div>
    </div>
    <div class="card" data-go="v2">
      <div class="badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19h16"/><path d="M4 19V5"/><path d="M4 15c3-6 5-8 7-4s5 2 9-6"/></svg></div>
      <div><span class="num">02</span><div class="ttl">酸素解離曲線 拡大図</div></div>
    </div>
    <div class="card" data-go="v3">
      <div class="badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17V6a1 1 0 0 1 1-1h9v12"/><path d="M13 9h4l3 4v4"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/></svg></div>
      <div><span class="num">03</span><div class="ttl">「酸素トラック」積み下ろし</div></div>
    </div>
    <div class="card" data-go="v4">
      <div class="badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 9a3 3 0 1 1 4 2.8c-1 .4-1.5 1.1-1.5 2.2v.5"/><circle cx="12" cy="18" r=".6" fill="currentColor" stroke="none"/></svg></div>
      <div><span class="num">04</span><div class="ttl">仮に全部降ろしたら</div></div>
    </div>
    <div class="card" data-go="v5">
      <div class="badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8"/><path d="M4 12h16"/><path d="M12 4c2.5 2.3 4 5 4 8s-1.5 5.7-4 8c-2.5-2.3-4-5-4-8s1.5-5.7 4-8z"/></svg></div>
      <div><span class="num">05</span><div class="ttl">発展の問い（胎児・高地）</div></div>
    </div>
    <div class="card" data-go="app">
      <div class="badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="14" rx="2"/><path d="M8 21h8"/><path d="M12 18v3"/><path d="M9 10l2 2-2 2"/></svg></div>
      <div><span class="num">06</span><div class="ttl">生徒用インタラクティブアプリ</div></div>
    </div>
  </div>
</div>

<!-- 図1 -->
<div class="view diagram" id="v1">
  <button class="back" data-back><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>一覧へ</button>
  <div class="dtitle">肺と組織における酸素濃度（相対値）</div>
