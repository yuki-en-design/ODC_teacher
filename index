    <div class="roadwrap">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17V6a1 1 0 0 1 1-1h9v12"/><path d="M13 9h4l3 4v4"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/></svg>
      <div class="arrowline"></div>
    </div>
    <div class="organ tissue"><div class="l1">組織</div><div class="l2">40</div><div class="l3">酸素濃度（相対値）</div></div>
  </div>
</div>

<!-- 図2 -->
<div class="view diagram" id="v2">
  <button class="back" data-back><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>一覧へ</button>
  <div class="dtitle">酸素解離曲線</div>
  <svg class="graph" id="v2graph" viewBox="0 0 320 210" role="img" style="cursor:crosshair;">
    <line x1="40" y1="180" x2="300" y2="180" stroke="#c7cdc6" stroke-width="1.5"/>
    <line x1="40" y1="20" x2="40" y2="180" stroke="#c7cdc6" stroke-width="1.5"/>
    <text x="170" y="203" text-anchor="middle" font-size="12" fill="#6b7268">酸素濃度（相対値）</text>
    <text x="14" y="100" text-anchor="middle" font-size="11" fill="#6b7268" transform="rotate(-90 14 100)">酸素ヘモグロビンの割合（%）</text>
    <text x="34" y="184" text-anchor="end" font-size="11" fill="#9aa39c">0</text>
    <text x="34" y="24" text-anchor="end" font-size="11" fill="#9aa39c">100</text>
    <text x="40" y="192" text-anchor="middle" font-size="11" fill="#9aa39c">0</text>
    <text x="300" y="192" text-anchor="middle" font-size="11" fill="#9aa39c">100</text>
    <path class="curve-a" d="M40,180 L66,141.0 L92,89.8 L118,61.0 L144,45.9 L170,37.6 L196,32.6 L222,29.4 L248,27.4 L274,25.9 L300,24.8" fill="none" stroke-width="4" stroke-linecap="round"/>
    <path class="curve-b" d="M40,180 L66,169.0 L92,143.4 L118,116.0 L144,93.3 L170,76.2 L196,63.7 L222,54.6 L248,47.8 L274,42.9 L300,39.0" fill="none" stroke-width="4" stroke-linecap="round"/>
    <g id="v2pts" opacity="0">
      <circle cx="300" cy="24.8" r="7" fill="#17805e" stroke="#fff" stroke-width="2.5"/>
      <text x="288" y="14" text-anchor="end" font-size="18" font-weight="700" fill="#0b4a35">肺　97%</text>
      <circle cx="118" cy="116" r="7" fill="#b65b34" stroke="#fff" stroke-width="2.5"/>
      <text x="130" y="134" text-anchor="start" font-size="18" font-weight="700" fill="#7c3d20">組織　40%</text>
    </g>
    <rect x="40" y="20" width="260" height="160" fill="transparent"/>
    <line id="v2pick-x" x1="0" y1="0" x2="0" y2="180" stroke="#16211b" stroke-width="1" stroke-dasharray="2,2" opacity="0"/>
    <line id="v2pick-y" x1="40" y1="0" x2="0" y2="0" stroke="#16211b" stroke-width="1" stroke-dasharray="2,2" opacity="0"/>
    <circle id="v2pick-marker" cx="0" cy="0" r="6" fill="#16211b" stroke="#fff" stroke-width="2" opacity="0"/>
  </svg>
  <div class="readout" id="v2readout">グラフをクリックすると、その位置の割合が読み取れます</div>
  <button class="toggle-btn" id="v2toggle">肺・組織の答えを表示</button>
</div>

<!-- 図3 -->
<div class="view diagram" id="v3">
  <button class="back" data-back><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>一覧へ</button>
  <div class="dtitle">ヘモグロビン ＝ 酸素トラック</div>
  <div class="card3">
    <div style="display:flex; justify-content:space-between; font-size:13px; font-weight:700; color:#6b7280; margin-bottom:8px;">
      <span>肺胞</span><span>組織</span>
    </div>
    <div style="position:relative; height:60px; border-bottom:2px dashed #cbd5e1; margin-bottom:16px;">
      <div id="particle-container3" style="position:absolute; width:100%; height:100%; top:0; left:0; pointer-events:none;"></div>
      <div id="truck3" style="position:absolute; left:0; bottom:2px; transition: left 1.6s ease-in-out;">
        <svg id="truck-icon-svg3" width="52" height="52" viewBox="0 0 28 28">
          <g id="cargo-o2-group3">
            <circle cx="6" cy="11" r="2.2" fill="#ffffff" opacity="0.9" />
            <circle cx="10" cy="11" r="2.2" fill="#ffffff" opacity="0.9" />
            <circle cx="8" cy="8" r="2.2" fill="#ffffff" opacity="0.9" />
            <circle cx="4" cy="8" r="1.8" fill="#ffffff" opacity="0.8" />
            <circle cx="11" cy="8" r="1.8" fill="#ffffff" opacity="0.8" />
            <text x="7.5" y="10" font-size="3.5" font-weight="900" text-anchor="middle" fill="#1f2937" opacity="0.95">O₂</text>
          </g>
          <path id="truck-body3" fill="#10b981" d="M5 17h-2v-11a1 1 0 0 1 1 -1h9v12m-4 0h6m4 0h2v-6h-8m0 -5h5l3 5 M7 17a2 2 0 1 0 0 0.01 M17 17a2 2 0 1 0 0 0.01"/>
          <path stroke="#64748b" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none" d="M7 17a2 2 0 1 0 0 0.01 M17 17a2 2 0 1 0 0 0.01 M5 17h-2v-11a1 1 0 0 1 1 -1h9v12m-4 0h6m4 0h2v-6h-8m0 -5h5l3 5"/>
        </svg>
      </div>
    </div>
    <div id="bubbles3" style="display:flex; gap:6px; justify-content:center; margin-bottom:12px;"></div>
